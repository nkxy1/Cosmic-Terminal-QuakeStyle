# Command line
cli-description = Quake-style drop-down terminal for COSMIC
cli-usage = Usage
cli-start = start (or show the running instance)
cli-toggle = show/hide; starts the daemon if needed
cli-show = show the terminal
cli-hide = hide the terminal
cli-quit = stop the running daemon
cli-daemon = start hidden in the background (for autostart)
cli-height = height in percent of the screen (10-100)
cli-width = width in percent of the screen (10-100)
cli-animation = slide animation: on, off or milliseconds (default 300)
cli-monitor = monitor: active or an output name (see --list-monitors)
cli-list-monitors = list the connected monitors
cli-new-tab = open a new tab
cli-split-horizontal = split the current terminal horizontally
cli-split-vertical = split the current terminal vertically
cli-help = show this help
cli-live-note = Settings can be combined; a running daemon applies them immediately.
cli-already-running = cosmic-quake-term is already running
cli-not-running = cosmic-quake-term is not running
cli-unknown-argument = unknown argument { $argument }
cli-needs-percent = { $flag } needs a whole number (percent)
cli-needs-animation = { $flag } needs on, off or a duration in milliseconds
cli-needs-monitor = { $flag } needs active or a monitor name
cli-contact-failed = failed to contact cosmic-quake-term: { $error }
cli-save-failed = failed to save settings: { $error }
cli-summary = height { $height } %, width { $width } %, animation { $animation }, monitor { $monitor }
cli-monitor-active = active
cli-no-monitors = no monitors known yet
cli-animation-off = off
cli-animation-ms = { $ms } ms
